# Copia este archivo a .env y rellena los valores. MAI no pugis .env al repositori.
# Genera la clave con: php artisan key:generate

APP_NAME=
APP_ENV=
APP_KEY=
APP_DEBUG=
APP_URL=

# Base de datos: SQL Server (driver sqlsrv)
DB_CONNECTION=
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=
SESSION_LIFETIME=

# true cuando los 4 juegos estén unidos en la landing (se abren en orden)
GAMES_ENFORCE_ORDER=
